{
  "redirects": [
    {"source": "/download", "destination": "https://github.com/YuanchengLi2/gumbo-releases/releases/latest/download/Gumbo-Setup.exe", "permanent": false},
    {"source": "/download/windows", "destination": "https://github.com/YuanchengLi2/gumbo-releases/releases/latest/download/Gumbo-Setup.exe", "permanent": false},
    {"source": "/app", "destination": "/app/", "permanent": true}
  ],
  "rewrites": [
    {"source": "/app/engine/app/:kind(scene|draft)/:id/index.html", "destination": "/app/engine/host.html"}
  ],
  "headers": [
    {
      "source": "/((?!app/engine/).*)",
      "headers": [
        {"key": "X-Frame-Options", "value": "DENY"},
        {"key": "Content-Security-Policy", "value": "frame-ancestors 'none'"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Content-Type-Options", "value": "nosniff"}
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {"key": "Cross-Origin-Opener-Policy", "value": "same-origin"},
        {"key": "Cross-Origin-Embedder-Policy", "value": "credentialless"}
      ]
    },
    {
      "source": "/app/engine/(.*)",
      "headers": [
        {"key": "X-Frame-Options", "value": "SAMEORIGIN"},
        {"key": "Content-Security-Policy", "value": "frame-ancestors 'self'"},
        {"key": "Referrer-Policy", "value": "no-referrer"},
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Cross-Origin-Resource-Policy", "value": "cross-origin"},
        {"key": "Access-Control-Allow-Origin", "value": "*"}
      ]
    },
    {
      "source": "/app/sw.js",
      "headers": [
        {"key": "Cache-Control", "value": "no-cache"}
      ]
    },
    {
      "source": "/app/",
      "headers": [
        {"key": "Cache-Control", "value": "no-cache"}
      ]
    },
    {
      "source": "/app/assets/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "public, max-age=31536000, immutable"}
      ]
    },
    {
      "source": "/dashboard(.*)",
      "headers": [
        {"key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive"},
        {"key": "Cache-Control", "value": "no-store"}
      ]
    }
  ]
}
