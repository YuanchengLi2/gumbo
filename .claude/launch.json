{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "website",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "http-server",
        "sign-in-site",
        "-p",
        "4173",
        "-c-1",
        "--silent"
      ],
      "port": 4173
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@dream/web",
        "dev"
      ],
      "port": 5180
    },
    {
      "name": "dashboard",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dashboard"
      ],
      "port": 4317
    }
  ]
}
