{
  "manifest_version": 3,
  "name": "Gumbo",
  "description": "Tab finishes what you type, Ctrl+K rewrites and answers in place, and Gumbo remembers what you read, write and hear, on your computer.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "key": "",
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "action": {"default_popup": "popup.html", "default_title": "Gumbo", "default_icon": {"16": "icons/16.png", "32": "icons/32.png"}},
  "background": {"service_worker": "background.js", "type": "module"},
  "permissions": ["storage", "unlimitedStorage", "tabs", "scripting", "history", "offscreen", "alarms", "idle", "bookmarks", "sidePanel", "tabCapture"],
  "optional_permissions": ["debugger"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {"matches": ["https://usegumbo.app/app/*"], "js": ["signin.js"], "run_at": "document_start"},
    {"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end", "all_frames": true, "match_about_blank": true, "match_origin_as_fallback": true}
  ],
  "web_accessible_resources": [{"resources": ["card.html", "card.js", "card.css"], "matches": ["<all_urls>"], "use_dynamic_url": true}],
  "side_panel": {"default_path": "sidepanel.html"},
  "commands": {
    "listen": {"suggested_key": {"default": "Alt+Shift+L"}, "description": "Listen to this tab (live captions and notes)"}
  },
  "content_security_policy": {"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"}
}
